# .env.example (copy to .env and fill in by hand)

# --- Database ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/receipts"

# --- Gemini ---
# Write this key by hand. Never let an agent write it.
# GEMINI_API_KEY="paste-your-key-here"

# --- Cloudflare R2 (S3-compatible) ---
# R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID="placeholder-access-key-id"
# R2_SECRET_ACCESS_KEY="placeholder-secret-access-key"
# R2_BUCKET="receipts-private"

# --- Local development storage (MinIO). Use instead of the R2 values above ---
# R2_ENDPOINT="http://localhost:9000"
# R2_ACCESS_KEY_ID="minioadmin"
# R2_SECRET_ACCESS_KEY="minioadmin"
# R2_BUCKET="receipts-dev"

# --- App secrets ---
# COOKIE_SIGNING_SECRET="placeholder-cookie-signing-secret"
# IP_HASH_SALT="placeholder-ip-hash-salt"

